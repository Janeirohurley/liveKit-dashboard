# Local environment configuration for LiveKit Dashboard

# --- LiveKit server -------------------------------------------------------
# The API key and secret are cluster-wide credentials: anything holding them can
# create rooms, mint participant tokens, and read every room on the deployment.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_REGION=auto

# --- Metrics --------------------------------------------------------------
# Prometheus endpoint exposed by livekit-server. Without it the monitoring and
# dashboard pages report "n/a" instead of guessing: nothing is fabricated when
# this is unset. Must be reachable from the dashboard process, not just a browser.
LIVEKIT_METRICS_URL=http://localhost:9090/metrics

# --- Dashboard database ---------------------------------------------------
# PostgreSQL connection string. Holds admin accounts, sessions, the audit log,
# webhook events, and metrics history. Required in production.
DATABASE_URL=postgres://livekit:livekit@localhost:5432/livekit_dashboard

# --- Sessions and webhook verification ------------------------------------
# Secret used to HMAC session tokens and to verify LiveKit webhook signatures.
# Generate per environment: openssl rand -hex 32. Required in production.
DASHBOARD_SESSION_SECRET=replace-with-a-32-byte-random-hex-string
